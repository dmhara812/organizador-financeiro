APP_NAME="Finance Investment Organizer API"
ENVIRONMENT="local"
DEBUG=true
API_V1_PREFIX="/api/v1"

BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'

POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="finance_user"
