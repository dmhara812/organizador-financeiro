APP_NAME="Finance Investment Organizer API"
APP_VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Gere uma chave local com:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="replace-this-with-a-generated-local-secret-key-with-at-least-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="finance_user"
POSTGRES_PASSWORD="finance_password"
POSTGRES_DB="finance_app"
DATABASE_URL=